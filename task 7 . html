<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ElectroHub | Electronics Catalog</title>

    <style>
        /* GENERAL STYLES */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
            color: #1e293b;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .container {
            width: 90%;
            max-width: 1250px;
            margin: auto;
        }

        /* HEADER */
        header {
            background: #0f172a;
            color: white;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.15);
        }

        .navbar {
            min-height: 75px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .logo {
            font-size: 27px;
            font-weight: bold;
            color: #38bdf8;
        }

        .logo span {
            color: white;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        .nav-links a {
            color: #e2e8f0;
            font-weight: 500;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #38bdf8;
        }

        .cart {
            background: #0284c7;
            color: white;
            padding: 10px 17px;
            border-radius: 7px;
            font-weight: bold;
        }

        /* HERO SECTION */
        .hero {
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            padding: 60px 5%;
            background: linear-gradient(135deg, #0f172a, #075985);
            color: white;
            overflow: hidden;
        }

        .hero-content {
            max-width: 600px;
            animation: slideIn 1s ease;
        }

        .hero h1 {
            font-size: clamp(35px, 5vw, 55px);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #38bdf8;
        }

        .hero p {
            color: #cbd5e1;
            margin-bottom: 25px;
            font-size: 17px;
        }

        .hero-btn {
            display: inline-block;
            padding: 13px 25px;
            background: #38bdf8;
            color: #0f172a;
            border-radius: 7px;
            font-weight: bold;
            transition: 0.3s;
        }

        .hero-btn:hover {
            background: white;
            transform: translateY(-4px);
        }

        .hero-image {
            font-size: 150px;
            animation: float 3s ease-in-out infinite;
        }

        /* SEARCH BAR */
        .search-section {
            margin: 35px auto;
            text-align: center;
        }

        .search-section h2 {
            margin-bottom: 15px;
        }

        .search-box {
            max-width: 650px;
            display: flex;
            margin: auto;
            background: white;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            overflow: hidden;
        }

        .search-box input {
            width: 100%;
            padding: 15px;
            border: none;
            outline: none;
            font-size: 15px;
        }

        .search-box button {
            padding: 0 22px;
            border: none;
            background: #0284c7;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        /* CATEGORY FILTERS */
        .categories {
            padding: 25px 0 45px;
            text-align: center;
        }

        .section-title {
            text-align: center;
            font-size: 32px;
            margin-bottom: 30px;
            color: #0f172a;
        }

        .section-title span {
            color: #0284c7;
        }

        .category-filters {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .category-filters a {
            padding: 10px 22px;
            background: white;
            border: 1px solid #cbd5e1;
            border-radius: 25px;
            transition: 0.3s;
        }

        .category-filters a:hover {
            background: #0284c7;
            color: white;
            border-color: #0284c7;
        }

        /* PRODUCT GRID */
        .products-section {
            padding: 40px 0 70px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 25px;
        }

        .product-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            border: 1px solid #e2e8f0;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(15, 23, 42, 0.12);
        }

        .discount {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #ef4444;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: bold;
            z-index: 1;
        }

        .product-image {
            height: 210px;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 90px;
            transition: 0.4s;
        }

        .product-card:hover .product-image {
            background: #e0f2fe;
        }

        .product-info {
            padding: 20px;
        }

        .category-name {
            color: #0284c7;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .product-info h3 {
            margin: 8px 0;
            font-size: 18px;
        }

        .rating {
            color: #f59e0b;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .rating span {
            color: #64748b;
        }

        .price {
            font-size: 23px;
            font-weight: bold;
            color: #0284c7;
        }

        .old-price {
            font-size: 14px;
            color: #94a3b8;
            text-decoration: line-through;
            margin-left: 5px;
        }

        .product-specs {
            list-style: none;
            margin: 15px 0;
            font-size: 13px;
            color: #64748b;
        }

        .product-specs li {
            padding: 4px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .product-buttons {
            display: flex;
            gap: 8px;
            margin-top: 15px;
        }

        .btn {
            display: inline-block;
            text-align: center;
            padding: 10px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-primary {
            background: #0284c7;
            color: white;
            flex: 1;
        }

        .btn-primary:hover {
            background: #0369a1;
        }

        .btn-secondary {
            border: 1px solid #0284c7;
            color: #0284c7;
        }

        .btn-secondary:hover {
            background: #e0f2fe;
        }

        /* PRODUCT DETAILS */
        .details-section {
            padding: 70px 0;
            background: white;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .details-image {
            min-height: 350px;
            background: linear-gradient(135deg, #e0f2fe, #f1f5f9);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            font-size: 160px;
        }

        .details-content h2 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .details-content p {
            color: #64748b;
            margin: 15px 0;
        }

        .details-price {
            font-size: 32px;
            color: #0284c7;
            font-weight: bold;
            margin: 20px 0;
        }

        .spec-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        .spec-table th,
        .spec-table td {
            padding: 12px;
            border: 1px solid #e2e8f0;
            text-align: left;
        }

        .spec-table th {
            background: #f1f5f9;
            width: 35%;
        }

        /* COMPARISON TABLE */
        .comparison-section {
            padding: 70px 0;
        }

        .table-container {
            overflow-x: auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
        }

        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        .comparison-table th,
        .comparison-table td {
            padding: 16px;
            border-bottom: 1px solid #e2e8f0;
            text-align: center;
        }

        .comparison-table th {
            background: #0f172a;
            color: white;
        }

        .comparison-table tbody tr:hover {
            background: #f0f9ff;
        }

        .comparison-table td:first-child {
            text-align: left;
            font-weight: bold;
        }

        .table-price {
            color: #0284c7;
            font-weight: bold;
        }

        /* FEATURES */
        .features {
            padding: 60px 0;
            background: #e0f2fe;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .feature-card {
            text-align: center;
            padding: 30px 20px;
            background: white;
            border-radius: 12px;
            transition: 0.3s;
        }

        .feature-card:hover {
            transform: translateY(-6px);
        }

        .feature-icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .feature-card h3 {
            margin-bottom: 10px;
        }

        .feature-card p {
            color: #64748b;
        }

        /* NEWSLETTER */
        .newsletter {
            padding: 60px 20px;
            text-align: center;
            background: #0f172a;
            color: white;
        }

        .newsletter h2 {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .newsletter p {
            color: #cbd5e1;
            margin-bottom: 20px;
        }

        .newsletter-form {
            display: flex;
            max-width: 500px;
            margin: auto;
            gap: 10px;
        }

        .newsletter-form input {
            flex: 1;
            min-width: 0;
            padding: 14px;
            border: none;
            border-radius: 6px;
        }

        .newsletter-form button {
            padding: 14px 20px;
            background: #38bdf8;
            color: #0f172a;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }

        /* FOOTER */
        footer {
            background: #020617;
            color: #cbd5e1;
            padding: 45px 0 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 35px;
            margin-bottom: 30px;
        }

        .footer-column h3 {
            color: white;
            margin-bottom: 15px;
        }

        .footer-column p,
        .footer-column a {
            display: block;
            color: #94a3b8;
            margin-bottom: 8px;
            transition: 0.3s;
        }

        .footer-column a:hover {
            color: #38bdf8;
        }

        .copyright {
            text-align: center;
            border-top: 1px solid #1e293b;
            padding-top: 20px;
            font-size: 14px;
        }

        /* ANIMATIONS */
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-40px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        /* RESPONSIVE DESIGN */
        @media (max-width: 1050px) {
            .product-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .hero-image {
                font-size: 120px;
            }
        }

        @media (max-width: 768px) {
            .navbar {
                flex-wrap: wrap;
                padding: 15px 0;
            }

            .nav-links {
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
                gap: 15px;
            }

            .hero {
                flex-direction: column-reverse;
                text-align: center;
                padding: 45px 6%;
            }

            .hero-image {
                font-size: 100px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }

            .section-title {
                font-size: 27px;
            }
        }

        @media (max-width: 480px) {
            .product-grid {
                grid-template-columns: 1fr;
            }

            .product-image {
                height: 190px;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .cart {
                padding: 8px 12px;
            }

            .search-box button {
                padding: 0 12px;
            }

            .details-image {
                min-height: 250px;
                font-size: 110px;
            }
        }
    </style>
</head>

